{
  "name": "caelogram",
  "version": "0.1.0",
  "type": "module",
  "description": "Command-line client for Caelogram: map an existing Git checkout, obtain bounded task context, and publish draft pull requests through the Caelogram service.",
  "license": "UNLICENSED",
  "homepage": "https://github.com/Gitbub0816/caelogram#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gitbub0816/caelogram.git"
  },
  "bugs": {
    "url": "https://github.com/Gitbub0816/caelogram/issues"
  },
  "keywords": [
    "caelogram",
    "cli",
    "mcp",
    "code-context",
    "repository-map",
    "ai-agents",
    "github",
    "typescript"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "caelogram": "dist/cli.js"
  },
  "files": [
    "dist/cli.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:cli",
    "build:cli": "node --import tsx scripts/build-cli.ts",
    "pack:cli": "npm run build:cli && npm pack ./dist/package",
    "publish:cli": "npm run build:cli && npm publish ./dist/package --provenance --access public",
    "prepublishOnly": "node -e \"console.error('Publish the CLI package with: npm run publish:cli (the repository root carries server dependencies).'); process.exit(1)\"",
    "start": "node dist/server.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "cli": "node --import tsx src/cli.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "dev:api": "node --import tsx src/server.ts",
    "check:cloud": "tsc -p cloudflare/tsconfig.json",
    "cloud:dev": "wrangler dev",
    "cloud:migrate": "wrangler d1 migrations apply caelogram --remote",
    "cloud:deploy": "npm run build && npm run check:cloud && wrangler deploy",
    "cloud:check": "npm run check:cloud && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@clerk/react": "^6.15.1",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/auth-app": "^8.1.2",
    "commander": "^14.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1",
    "typescript": "^5.9.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20260903.0-alpha",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "vite": "^7.1.0",
    "wrangler": "^4.129.0"
  }
}
