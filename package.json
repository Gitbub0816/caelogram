{
  "name": "caelogram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The living map between your AI and your code",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "caelogram": "dist/cli.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "node dist/server.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "cli": "node --import tsx src/cli.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "dev:api": "node --import tsx src/server.ts",
    "check:cloud": "tsc -p cloudflare/tsconfig.json",
    "cloud:dev": "wrangler dev",
    "cloud:migrate": "wrangler d1 migrations apply caelogram --remote",
    "cloud:deploy": "npm run build && npm run check:cloud && wrangler deploy",
    "cloud:check": "npm run check:cloud && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/auth-app": "^8.1.2",
    "commander": "^14.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1",
    "typescript": "^5.9.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20260903.0-alpha",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "vite": "^7.1.0",
    "wrangler": "^4.129.0"
  }
}
