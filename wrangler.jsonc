{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caelogram",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "define": {
    "__filename": "\"/bundle/worker.js\"",
    "__dirname": "\"/bundle\"",
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "caelogram",
      // Pinned: resolving by name alone lets a deploy bind to a different
      // database than the one the CLI migrates.
      "database_id": "bacf0d94-4342-4ae3-a9c3-6b290f81978c",
      "migrations_dir": "cloudflare/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "SOURCE", "bucket_name": "caelogram-private" }],
  "triggers": { "crons": ["* * * * *"] },
  "queues": {
    "producers": [{ "binding": "INDEX_QUEUE", "queue": "caelogram-index" }],
    "consumers": [
      {
        "queue": "caelogram-index",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 5,
      },
    ],
  },
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 30000 },
  "ratelimits": [
    {
      "name": "REQUEST_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://caelogram.com",
    "INSTALLATIONS": "{}",
  },
}
